    "footer": "transcribe.footer"
  },
  "slotDefaults": {
    "right_sidebar": {
      "order": 100,
      "side": "hidden"
    },
    "footer": {
      "side": "right",
      "order": 10
    }
  },
  "datasets": [
    {
      "id": "transcriptions",
      "store": "durable",
      "version": 1,
      "title": "Transcriptions",
      "primaryKey": [
        "id"
      ],
      "columns": {
        "id": {
          "type": "text"
        },
        "file": {
          "type": "text"
        },
        "fileHash": {
          "type": "text"
        },
        "language": {
          "type": "text"
        },
        "model": {
          "type": "text",
          "nullable": true
        },
        "transcriptionDurationMs": {
          "type": "integer",
          "nullable": true
        },
        "createdAt": {
          "type": "datetime"
        }
      },
      "indexes": [
        {
          "id": "file",
          "columns": [
            "file"
          ],
          "unique": true
        }
      ],
      "titleKey": "auto.ef84d55ad876"
    },
    {
      "id": "transcript_segments",
      "store": "durable",
      "version": 1,
      "title": "Transcript segments",
      "primaryKey": [
        "transcriptionId",
        "position"
      ],
      "columns": {
        "transcriptionId": {
          "type": "text"
        },
        "position": {
          "type": "integer"
        },
        "segmentId": {
          "type": "text"
        },
        "start": {
          "type": "real"
        },
        "end": {
          "type": "real"
        },
        "text": {
          "type": "text"
        }
      },
      "indexes": [
        {
          "id": "segment_id",
          "columns": [
            "segmentId"
          ],
          "unique": true
        }
      ],
      "relations": [
        {
          "kind": "foreign-key",
          "columns": [
            "transcriptionId"
          ],
          "targetDataset": "transcriptions",
          "targetColumns": [
            "id"
          ],
          "onDelete": "cascade"
        }
      ],
      "titleKey": "auto.c19cabc4a949"
    }
  ],
  "pathRefs": [
    {
      "source": "dataset",
      "dataset": "transcribe.transcriptions",
      "pathColumn": "file"
    }
  ],
  "provides": [
    {
      "id": "metadataPanel.segment",
      "kind": "extension",
      "version": "1.0.0"
    },
    {
      "id": "fileTree.contextItem",
      "kind": "extension",
      "version": "1.0.0"
    },
    {
      "id": "workspace.surface",
      "version": "1.0.0",
      "kind": "extension"
    }
  ],
  "drivers": [],
  "guardPresets": {
    "schemaVersion": 1,
    "defaultPreset": "recommended",
    "presets": [
      {
        "id": "recommended",
        "label": "Recommended",
        "version": 1,
        "description": "Local Whisper stays on this machine. OpenAI runs upload audio only after the cloud engine is selected and a transcription is started.",
        "entries": {
          "commands": {
            "file": {
              "decision": "allow"
            }
          }
        }
      },
      {
        "id": "ask-for-writes",
        "label": "Ask for writes",
        "version": 1,
        "description": "Confirm before a transcription starts — local runs can occupy the CPU and OpenAI runs upload the selected audio.",
        "entries": {
          "commands": {
            "file": {
              "decision": "confirm",
              "allowPreApproval": false
            }
          }
        }
      },
      {
        "id": "blocked",
        "label": "Blocked",
        "version": 1,
        "description": "No transcriptions at all.",
        "entries": {
          "commands": {
            "file": {
              "decision": "deny"
            }
          }
        }
      }
    ]
  },
  "notifications": [
    {
      "id": "done",
      "label": "Transcription finished",
      "labelKey": "plugin.transcribe.notification.done",
      "description": "A run takes minutes with the app in the background, which is where a toast would land unseen.",
      "descriptionKey": "plugin.transcribe.notification.doneDesc",
      "defaultChannel": "system"
    },
    {
      "id": "failed",
      "label": "Transcription failed",
      "labelKey": "plugin.transcribe.notification.failed",
      "description": "Announces a run that ended with an error, with the reason.",
      "descriptionKey": "plugin.transcribe.notification.failedDesc",
      "defaultChannel": "system"
    }
  ],
