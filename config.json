      "ffmpeg"
    ],
    "network": {
      "hosts": [
        "openaipublic.azureedge.net",
        "api.openai.com"
      ],
      "allowUserEndpoints": true
    },
    "accounts": [
      "ai.transcribe"
    ],
    "storage": {
      "vault": true
    }
  },
  "connectionProviders": [
    {
      "id": "openai",
      "name": "OpenAI",
      "description": "OpenAI chat and transcription provider",
      "icon": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "capabilities": [
        "ai.chat",
        "ai.stream",
        "ai.tools",
        "ai.models",
        "ai.vision-image",
        "ai.transcribe",
        "ai.embeddings"
      ],
      "requiresKey": true,
      "environmentKeys": [
        "OPENAI_API_KEY"
      ],
      "connectionSource": {
        "config": ".valley/assistant/assistant.json",
        "secrets": ".valley/assistant/provider-secrets.json",
        "keyPrefix": "provider:"
      }
    }
  ]
}
